APP_NAME=fleet-management-service
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://fleetops:fleetops@localhost:5432/fleet_management

RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=fleetops.events

# Debe ser identica a la de api-gateway (services/api-gateway/.env), que valida
# los tokens que este servicio firma. Cambiar por un valor real en produccion.
JWT_SECRET_KEY=dev-secret-cambiar-en-produccion
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTOS=60

CORS_ORIGINS=["*"]
