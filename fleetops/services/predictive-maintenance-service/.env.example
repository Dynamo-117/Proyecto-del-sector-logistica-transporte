APP_NAME=predictive-maintenance-service
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://fleetops:fleetops@localhost:5432/predictive_maintenance

RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=fleetops.events
RABBITMQ_QUEUE=predictive-maintenance.vehiculo-eventos
RABBITMQ_ROUTING_KEY=vehiculo.*

CORS_ORIGINS=["*"]
