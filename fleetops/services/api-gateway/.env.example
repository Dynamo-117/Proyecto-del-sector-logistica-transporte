APP_NAME=api-gateway
LOG_LEVEL=INFO

FLEET_MANAGEMENT_URL=http://localhost:8000
VEHICLE_TRACKING_URL=http://localhost:8002
ROUTE_OPTIMIZATION_URL=http://localhost:8003
PREDICTIVE_MAINTENANCE_URL=http://localhost:8004
NAVIGATION_INTEGRATION_URL=http://localhost:8005

PROXY_TIMEOUT_SEGUNDOS=30.0

# Debe ser identica a la de fleet-management-service (services/fleet-management-service/.env),
# que es quien firma los tokens. Cambiar por un valor real en produccion.
JWT_SECRET_KEY=dev-secret-cambiar-en-produccion
JWT_ALGORITHM=HS256

CORS_ORIGINS=["*"]
